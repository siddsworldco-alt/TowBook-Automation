{
  "name": "Towbook Weekly Invoice Automater (Sheets Mapping)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 5"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Every Friday 9am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://scraper:5050/scrape",
        "options": {
          "timeout": 600000
        }
      },
      "id": "http-scrape",
      "name": "Run Towbook Scraper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "accounts",
        "options": {}
      },
      "id": "split-accounts",
      "name": "Split Accounts",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 3,
      "position": [640, 300]
    },
    {
      "parameters": {
        "operation": "getAll",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_CONTACTS_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Contacts"
        },
        "options": {}
      },
      "id": "get-contacts",
      "name": "Get Contacts from Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [640, 500],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_CREDENTIAL_ID",
          "provider": "googleSheetsOAuth2Api"
        }
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByFields",
        "commonField": "name",
        "commonFieldOther": "AccountName",
        "options": {
          "clashHandling": "preferInput1"
        }
      },
      "id": "merge-contact",
      "name": "Match Contact",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [860, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.Email }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "check-email",
      "name": "Has Email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "filePath": "=/app/output/csv_downloads/{{ $json.filename }}"
      },
      "id": "read-acc-csv",
      "name": "Read Individual CSV",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [1300, 180]
    },
    {
      "parameters": {
        "fromEmail": "notification@drivingjobs.online",
        "toEmail": "={{ $json.Email }}",
        "subject": "=Unpaid Invoice Report: {{ $json.name }}",
        "text": "=Hi {{ $json.Owner || 'there' }},\n\nPlease find attached the unpaid invoice report for {{ $json.name }}.\n\nTotal Balance: {{ $json.balance }}\n\nRegards,\nAutomation Bot",
        "attachments": "data",
        "options": {
          "appendAttachingBinary": true
        }
      },
      "id": "send-email",
      "name": "Send Email (SMTP)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1740, 100],
      "credentials": {
        "smtp": {
          "id": "YOUR_SMTP_CREDENTIAL_ID",
          "provider": "smtp"
        }
      }
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "parse-invoice-csv",
      "name": "Parse Invoice CSV",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [1520, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_REPORT_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "WeeklyReports"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "google-sheets-out",
      "name": "Google Sheets (Append)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1740, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_CREDENTIAL_ID",
          "provider": "googleSheetsOAuth2Api"
        }
      }
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "scraper-progress",
        "options": {}
      },
      "id": "webhook-progress",
      "name": "Scraper Progress Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [200, 100]
    },
    {
      "parameters": {
        "jsCode": "console.log(`[PROGRESS] ${$json.body.message}`);\nreturn $input.all();"
      },
      "id": "log-progress",
      "name": "Log Progress",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 100]
    }
  ],
  "connections": {
    "Every Friday 9am": {
      "main": [[{ "node": "Run Towbook Scraper", "type": "main", "index": 0 }]]
    },
    "Run Towbook Scraper": {
      "main": [[{ "node": "Split Accounts", "type": "main", "index": 0 }]]
    },
    "Split Accounts": {
      "main": [[{ "node": "Match Contact", "type": "main", "index": 0 }]]
    },
    "Get Contacts from Sheets": {
      "main": [[{ "node": "Match Contact", "type": "main", "index": 1 }]]
    },
    "Match Contact": {
      "main": [[{ "node": "Has Email?", "type": "main", "index": 0 }]]
    },
    "Has Email?": {
      "main": [
        [{ "node": "Read Individual CSV", "type": "main", "index": 0 }],
        []
      ]
    },
    "Read Individual CSV": {
      "main": [
        [
          { "node": "Send Email (SMTP)", "type": "main", "index": 0 },
          { "node": "Parse Invoice CSV", "type": "main", "index": 0 }
        ]
      ]
    },
    "Parse Invoice CSV": {
      "main": [[{ "node": "google-sheets-out", "type": "main", "index": 0 }]]
    },
    "Scraper Progress Webhook": {
      "main": [[{ "node": "Log Progress", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  }
}
